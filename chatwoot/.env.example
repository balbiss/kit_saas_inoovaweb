# Copie para .env (ou preencha direto na sua ferramenta de deploy, ex:
# Portainer "Environment variables" ao criar a stack) e preencha todos os
# valores antes de subir. NUNCA reaproveite os valores de exemplo/comentario.

# O docker-compose.yml espera uma rede Docker externa (overlay) chamada
# "app_network" -- crie antes de subir a stack (ou troque o nome direto no
# docker-compose.yml se preferir outro):
#   docker network create --driver overlay app_network

# Imagem do Chatwoot buildada por voce a partir do repo chatwoot_innovaweb
# (nao existe imagem publica pronta -- veja README.md desta pasta)
CHATWOOT_IMAGE=

# Dominio onde o Chatwoot vai responder (precisa apontar pro seu servidor/Traefik)
CHATWOOT_DOMAIN=crm.suaempresa.com.br
BRAND_NAME="Sua Empresa"
BRAND_COLOR=#028090

# Senhas/chaves -- gere um valor novo pra cada linha (rode o comando indicado
# e cole o resultado; NAO deixe o comando literal aqui, ele nao roda sozinho
# dentro do .env) e nunca reaproveite os de outro ambiente
CHATWOOT_POSTGRES_PASSWORD=   # openssl rand -hex 24
CHATWOOT_REDIS_PASSWORD=      # openssl rand -hex 24
CHATWOOT_SECRET_KEY_BASE=     # openssl rand -hex 64
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=              # openssl rand -base64 32
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=        # openssl rand -base64 32
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=      # openssl rand -base64 32
BAILEYS_API_KEY=              # openssl rand -hex 16

# Credencial da OpenAI usada pelo PROPRIO Chatwoot (recursos de IA nativos
# do fork, diferente da credencial OpenAI usada pelos workflows do n8n)
OPENAI_API_KEY=

# SMTP pra envio de e-mail (convite de agente, reset de senha, etc.)
SMTP_SENDER_EMAIL=suporte@suaempresa.com.br
SMTP_ADDRESS=smtp.suaempresa.com.br
SMTP_PORT=587
SMTP_USERNAME=suporte@suaempresa.com.br
SMTP_PASSWORD=
