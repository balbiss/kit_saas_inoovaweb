      "parameters": {
        "jsCode": "const kw = ($json.keyword || '').replace(/'/g, \"''\"); return [{ json: { ...$json, like_kw: '*' + kw + '*' } }];"
      }
    },
    {
      "id": "c7b28707-0bb3-4641-a922-7071229192ef",
      "name": "BUSCAR PRODUTOS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "{{ $env.SUPABASE_URL }}/rest/v1/products",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "nome:name,descricao:description,preco:price,categoria:category,foto_url:photo_url"
            },
            {
              "name": "company_id",
              "value": "=eq.{{ $json.company_id }}"
            },
            {
              "name": "available",
              "value": "eq.true"
            },
            {
              "name": "limit",
              "value": "5"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "HcfnrNOxcvDi7h8H",
          "name": "chatwoot_db"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "380700b1-5730-439c-a366-c8b8161d4e7d",
      "name": "PROCESSAR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst produtos = items.map(function(i) { return i.json; }).filter(function(p) { return p.nome; });\nif (!produtos.length) {\n  return [{ json: { texto: 'Nenhum produto encontrado no catalogo para essa busca.', foto_url: '', legenda: '' } }];\n}\nfunction fmt(p) {\n  const preco = p.preco ? 'R$ ' + parseFloat(p.preco).toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '';\n  let linha = '*' + p.nome + '*';\n  if (preco) linha += ' — ' + preco;\n  if (p.descricao) linha += '\\n' + p.descricao;\n  if (p.categoria) linha += '\\nCategoria: ' + p.categoria;\n  return linha;\n}\nconst texto = produtos.map(fmt).join('\\n\\n');\nconst comFoto = produtos.find(function(p) { return p.foto_url; });\nconst foto_url = comFoto ? comFoto.foto_url : '';\nconst legenda = comFoto ? (comFoto.nome + (comFoto.preco ? ' — R$ ' + parseFloat(comFoto.preco).toLocaleString('pt-BR', {minimumFractionDigits: 2}) : '')) : '';\nreturn [{ json: { texto: texto, foto_url: foto_url, legenda: legenda } }];"
      }
    },
    {
      "id": "79ce86ec-c478-47fa-9a03-de6b23780f79",
      "name": "TEM FOTO?",
