    },
    {
      "id": "filtrar-produtos-node",
      "name": "FILTRAR PRODUTOS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function normalizeWords(s) {\n  var n = (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();\n  n = n.replace(/[^a-z0-9]+/g, ' ').trim();\n  return n.length ? n.split(/\\s+/).filter(function(w){ return w.length >= 2; }) : [];\n}\nvar produtos = $input.all().map(function(i){ return i.json; }).filter(function(p){ return p && p.nome; });\nvar keyword = ($('GATILHO').item.json.keyword || '').trim();\nif (!keyword || keyword === '%') {\n  return produtos.slice(0, 5).map(function(p){ return { json: p }; });\n}\nvar searchWords = normalizeWords(keyword);\nvar scored = produtos.map(function(p) {\n  var corpusWords = normalizeWords((p.nome || '') + ' ' + (p.descricao || '') + ' ' + (p.categoria || ''));\n  var overlap = searchWords.filter(function(w){ return corpusWords.indexOf(w) !== -1; }).length;\n  return { produto: p, overlap: overlap };\n});\nvar matched = scored.filter(function(s){ return s.overlap > 0; }).sort(function(a, b){ return b.overlap - a.overlap; }).slice(0, 5);\nif (!matched.length) {\n  return [{ json: {} }];\n}\nreturn matched.map(function(m){ return { json: m.produto }; });"
      }
    }
  ],
