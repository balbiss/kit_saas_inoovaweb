            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3a29cd27-ddc2-44de-a860-56dc2778b4f8",
      "name": "RETORNAR",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "resultado",
