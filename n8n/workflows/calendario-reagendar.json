      "name": "PREPARAR NOVO EVENTO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        0
      ],
      "parameters": {
        "jsCode": "var g = $('GATILHO').item.json; var ag = $('BUSCAR AGENDAMENTO').item.json; var tk = $('BUSCAR TOKENS').item.json; var at = $('RENOVAR TOKEN').item.json; var duracao = (ag.resources && ag.resources.agenda_config && parseInt(ag.resources.agenda_config.duracao_minutos)) || 60; var calendarId = (ag.resources && ag.resources.calendar_id) || tk.calendar_id || 'primary'; var inicio = g.nova_data_hora.includes('+') || g.nova_data_hora.includes('Z') ? g.nova_data_hora : g.nova_data_hora + '-03:00'; var dInicio = new Date(inicio); var dFim = new Date(dInicio.getTime() + duracao * 60000); var fim = dFim.toISOString().replace('Z', '-03:00'); var titulo = 'REAGENDADO - ' + (ag.title || ''); var descParts = [(g.termo_contato || 'Cliente') + ': ' + g.nome_lead]; if (g.telefone) descParts.push('WhatsApp: ' + g.telefone); if (g.descricao) descParts.push(g.descricao); return [{ json: { access_token: at.access_token, calendar_id: calendarId, titulo: titulo, evento: { summary: titulo, description: descParts.join('\\n'), start: { dateTime: inicio, timeZone: 'America/Sao_Paulo' }, end: { dateTime: fim, timeZone: 'America/Sao_Paulo' } } } }];"
      }
