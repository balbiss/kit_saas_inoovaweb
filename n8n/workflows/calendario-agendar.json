    {
      "id": "validar-agendar-node",
      "name": "VALIDAR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "\nfunction normalizeWords(s) {\n  var n = (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\n  n = n.replace(/[^a-z0-9]+/g, ' ').trim();\n  return n.length ? n.split(/\\s+/).filter(function(w){ return w.length >= 2; }) : [];\n}\nfunction pickResource(resources, resourceNome) {\n  if (resources.length === 0) return { match: null, ambiguous: false, empty: true };\n  if (resources.length === 1) return { match: resources[0], ambiguous: false, empty: false };\n  if (!resourceNome) return { match: null, ambiguous: true, empty: false };\n  var searchWords = normalizeWords(resourceNome);\n  var scored = resources.map(function(r) {\n    var nameWords = normalizeWords(r.name);\n    var overlap = searchWords.filter(function(w){ return nameWords.indexOf(w) !== -1; }).length;\n    return { r: r, overlap: overlap };\n  });\n  var maxOverlap = Math.max.apply(null, scored.map(function(s){ return s.overlap; }));\n  var best = scored.filter(function(s){ return s.overlap === maxOverlap; });\n  if (maxOverlap > 0 && best.length === 1) return { match: best[0].r, ambiguous: false, empty: false };\n  return { match: null, ambiguous: true, empty: false };\n}\nvar g = $('GATILHO').item.json; var resources = $('BUSCAR CONFIG AGENDA').all().map(function(i) { return i.json; }); var tk = $('BUSCAR TOKENS').item.json; var pick = g.resource_id_direto ? (function(){ var d = resources.find(function(r){ return r.id === g.resource_id_direto; }); return d ? { match: d, ambiguous: false, empty: false } : { match: null, ambiguous: false, empty: true }; })() : pickResource(resources, g.resource_nome); if (pick.empty) { return [{ json: { ok: false, motivo: 'Nenhum profissional/agenda configurado para esta empresa.', refresh_token: '', calendar_id: '', duracao_minutos: 60, resource_id: '' } }]; } if (pick.ambiguous) { var ids = resources.map(function(r){ return r.name; }).join(', '); return [{ json: { ok: false, motivo: 'Nao consegui identificar com certeza qual profissional/especialista o cliente quer. Pergunte ao cliente qual deles e informe o nome exato em resource_nome. Opcoes: ' + ids + '.', refresh_token: '', calendar_id: '', duracao_minutos: 60, resource_id: '' } }]; } var res = pick.match; var cfg = res.agenda_config || {}; var refreshToken = tk.refresh_token || ''; if (!refreshToken) { return [{ json: { ok: false, motivo: 'Google Calendar nao conectado para esta conta.', refresh_token: '', calendar_id: '', duracao_minutos: 60, resource_id: res.id } }]; } return [{ json: { ok: true, motivo: '', refresh_token: refreshToken, calendar_id: res.calendar_id || tk.calendar_id || 'primary', duracao_minutos: parseInt(cfg.duracao_minutos) || 60, resource_id: res.id, exige_pagamento: !!res.exige_pagamento, valor_sinal: res.valor_sinal, tipo_cobranca: res.tipo_cobranca } }];"
      }
