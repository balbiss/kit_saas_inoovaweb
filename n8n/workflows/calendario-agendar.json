      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "var pendentes = $('BUSCAR PAGAMENTO PENDENTE').all().map(function(i){ return i.json; }).filter(function(p){ return p && p.id; });\nvar v = $('CHECAR BLOQUEIO').item.json;\nif (pendentes.length > 0) {\n  var pend = pendentes[0];\n  var valorTxt = Number(pend.valor).toFixed(2).replace('.', ',');\n  var rotulo = pend.tipo_cobranca === 'integral' ? 'Pix de R$ ' + valorTxt : 'Pix do sinal de R$ ' + valorTxt;\n  return [{ json: { ja_tem_pendente: true, confirmacao: 'Ja enviei um ' + rotulo + ' aguardando o pagamento pra confirmar esse horario. Assim que for pago, o agendamento e feito automaticamente.' } }];\n}\nreturn [{ json: { ja_tem_pendente: false, resource_id: v.resource_id, valor_sinal: v.valor_sinal, tipo_cobranca: v.tipo_cobranca } }];"
      }
