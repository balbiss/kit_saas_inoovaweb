    {
      "parameters": {
        "jsCode": "var g = $('GATILHO').item.json; var v = $('VALIDAR').item.json; var access_token = $json.access_token; var duracao = parseInt(v.duracao_minutos) || 60; var inicio = g.data_hora_inicio.includes('+') || g.data_hora_inicio.includes('Z') ? g.data_hora_inicio : g.data_hora_inicio + '-03:00'; var dInicio = new Date(inicio); var dFim = new Date(dInicio.getTime() + duracao * 60000); var fim = dFim.toISOString().replace('Z', '-03:00'); var telefone = g.telefone || ''; var termo = g.termo_contato || 'Cliente'; var descParts = [termo + ': ' + g.nome_lead]; if (telefone) descParts.push('WhatsApp: ' + telefone); if (g.descricao) descParts.push(g.descricao); return [{ json: { access_token: access_token, calendar_id: v.calendar_id || 'primary', evento: { summary: g.titulo, description: descParts.join('\\n'), start: { dateTime: inicio, timeZone: 'America/Sao_Paulo' }, end: { dateTime: fim, timeZone: 'America/Sao_Paulo' } } } }];"
