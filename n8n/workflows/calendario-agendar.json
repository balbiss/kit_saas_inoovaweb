    {
      "id": "checar-bloqueio-agendar",
      "name": "CHECAR BLOQUEIO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const v = $('VALIDAR').item.json;\nif (!v.ok) { return [{ json: v }]; }\nconst bloqueios = $input.all().map(function(i){ return i.json; }).filter(function(b){ return b && b.periodo; });\nconst dataHora = $('GATILHO').item.json.data_hora_inicio || '';\nconst hh = parseInt((dataHora.split('T')[1] || '00:00').split(':')[0], 10);\nfunction periodoBate(periodo) {\n  if (periodo === 'dia_todo') return true;\n  if (periodo === 'manha') return hh < 12;\n  if (periodo === 'tarde') return hh >= 12 && hh < 18;\n  if (periodo === 'noite') return hh >= 18;\n  return false;\n}\nconst bloqueado = bloqueios.find(function(b) { return periodoBate(b.periodo); });\nif (bloqueado) {\n  const motivo = 'Agenda bloqueada nesse periodo' + (bloqueado.motivo ? ' (' + bloqueado.motivo + ')' : '') + '.';\n  return [{ json: Object.assign({}, v, { ok: false, motivo: motivo }) }];\n}\nreturn [{ json: v }];"
      }
