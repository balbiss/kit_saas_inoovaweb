      "parameters": {
        "jsCode": "const dep = $('GATILHO').item.json.departamento || 'humano';\nconst teams = $input.all().map(function(i) { return i.json; }).filter(function(t) { return t && t.id; });\nconst team = teams.find(t => t.name === dep);\nreturn [{ json: { team_id: team ? team.id : null } }];"
