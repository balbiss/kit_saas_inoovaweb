        "jsCode": "var teamId = $('ENCONTRAR TIME').item.json.team_id;\nvar membros = $input.all().map(function(i){ return i.json; }).filter(function(m){ return m && m.id; });\nvar escolhido = membros.find(function(m){ return m.availability_status === 'online'; })\n  || membros.find(function(m){ return m.availability_status === 'busy'; })\n  || membros[0];\nreturn [{ json: { team_id: teamId, assignee_id: escolhido ? escolhido.id : null } }];"
