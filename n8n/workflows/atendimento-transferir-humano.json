    {
      "id": "3f914a6b-8a49-4f33-9dd1-f7dcdc41fec8",
      "name": "VERIFICAR HORARIO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = $json || {};\nconst dias = cfg.horario_atendimento_dias || [1,2,3,4,5];\nconst inicio = (cfg.horario_atendimento_inicio || '08:00:00').slice(0,5);\nconst fim = (cfg.horario_atendimento_fim || '18:00:00').slice(0,5);\nconst now = new Date();\nconst spOffset = -3 * 60 * 60 * 1000;\nconst spDate = new Date(now.getTime() + spOffset);\nconst spHour = spDate.getUTCHours();\nconst spMin = spDate.getUTCMinutes();\nconst spDay = spDate.getUTCDay();\nconst nowMinutes = spHour * 60 + spMin;\nconst [hi, mi] = inicio.split(':').map(Number);\nconst [hf, mf] = fim.split(':').map(Number);\nconst inicioMinutes = hi * 60 + mi;\nconst fimMinutes = hf * 60 + mf;\nconst overnight = fimMinutes <= inicioMinutes;\nlet isBusinessHour;\nif (overnight) {\n  isBusinessHour = nowMinutes >= inicioMinutes || nowMinutes < fimMinutes;\n} else {\n  isBusinessHour = nowMinutes >= inicioMinutes && nowMinutes < fimMinutes;\n}\nconst diaCheck = overnight ? (dias.includes(spDay) || dias.includes((spDay + 6) % 7)) : dias.includes(spDay);\nconst DIA_NOMES = ['dom','seg','ter','qua','qui','sex','sab'];\nconst diasOrdenados = [...dias].sort(function(a,b){ return a-b; });\nconst diasTexto = diasOrdenados.map(function(d){ return DIA_NOMES[d]; }).join(', ');\nconst horarioTexto = diasTexto + '., das ' + inicio + ' as ' + fim;\nreturn [{ json: { dentro_horario: diaCheck && isBusinessHour, horario_texto: horarioTexto } }];"
      }
    },
