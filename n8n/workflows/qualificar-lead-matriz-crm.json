        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const times = $input.all().map(i => i.json);\nconst departamento = ($('GATILHO').item.json.departamento || 'humano').toLowerCase();\nconst encontrado = times.find(t => (t.name || '').toLowerCase() === departamento);\nconst fallback = times.find(t => (t.name || '').toLowerCase() === 'humano');\nreturn [{ json: { team_id: (encontrado || fallback || times[0] || {}).id } }];"
      }
