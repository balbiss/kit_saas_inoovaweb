        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ company_id: $('GATILHO').item.json.company_id, product_id: $json.product_id, conversation_id: String($('GATILHO').item.json.id_conversa), contact_phone: $('GATILHO').item.json.telefone, valor: $json.price, status: 'pendente' }) }}",
        "options": {}
