    {
      "id": "resolver-produto-pix",
      "name": "RESOLVER PRODUTO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function normalizeWords(s) {\n  var n = (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();\n  n = n.replace(/[^a-z0-9]+/g, ' ').trim();\n  return n.length ? n.split(/\\s+/).filter(function(w){ return w.length >= 2; }) : [];\n}\nvar cfgItems = $('BUSCAR CONFIG PAGAMENTO').all().map(function(i){ return i.json; });\nvar cfg = cfgItems[0] || {};\nvar token = cfg.mercadopago_access_token || null;\nif (!token) {\n  return [{ json: { ok: false, motivo: 'Essa empresa ainda nao configurou pagamento automatico via Pix.' } }];\n}\nvar produtos = $('BUSCAR PRODUTOS PIX').all().map(function(i){ return i.json; }).filter(function(p){ return p && p.id; });\nvar termo = $('GATILHO').item.json.termo_produto || '';\nvar searchWords = normalizeWords(termo);\nvar scored = produtos.map(function(p) {\n  var nameWords = normalizeWords(p.name);\n  var overlap = searchWords.filter(function(w){ return nameWords.indexOf(w) !== -1; }).length;\n  return { produto: p, overlap: overlap };\n});\nscored.sort(function(a, b){ return b.overlap - a.overlap; });\nvar best = scored[0];\nif (!scored.length || !best || best.overlap === 0) {\n  return [{ json: { ok: false, motivo: 'Nao encontrei esse produto com pagamento automatico habilitado.' } }];\n}\nvar produto = best.produto;\nif (produto.estoque !== null && produto.estoque !== undefined && produto.estoque <= 0) {\n  return [{ json: { ok: false, motivo: 'Esse produto esta sem estoque no momento.' } }];\n}\nif (produto.price === null || produto.price === undefined) {\n  return [{ json: { ok: false, motivo: 'Esse produto nao tem preco cadastrado.' } }];\n}\nreturn [{ json: { ok: true, motivo: '', product_id: produto.id, product_name: produto.name, price: produto.price, mercadopago_access_token: token } }];"
      }
    },
    {
      "id": "pode-gerar",
