      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        100
      ],
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/products?select=id,name,price,tipo,estoque&company_id=eq.{{ $('GATILHO').item.json.company_id }}&vender_com_pix=eq.true&available=eq.true",
        "sendHeaders": true,
