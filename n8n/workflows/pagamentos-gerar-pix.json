        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ transaction_amount: $('RESOLVER PRODUTO').item.json.price, description: $('RESOLVER PRODUTO').item.json.product_name, payment_method_id: 'pix', payer: { email: 'cliente' + $('GATILHO').item.json.telefone.replace(/[^0-9]/g, '') + '@example.com' }, external_reference: $json.id, notification_url: '{{ $env.N8N_URL }}/webhook/pagamentos-mercadopago?company_id=' + $('GATILHO').item.json.company_id + '&pedido_id=' + $json.id, date_of_expiration: new Date(Date.now() + 30 * 60000).toISOString() }) }}",
        "options": {}
