    {
      "id": "preparar-qr",
      "name": "PREPARAR QR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "var mp = $('GERAR COBRANCA MP').all()[0].json;\nvar td = (mp.point_of_interaction && mp.point_of_interaction.transaction_data) || {};\nvar qrBase64 = td.qr_code_base64 || '';\nvar qrCode = td.qr_code || '';\nvar produto = $('RESOLVER PRODUTO').item.json;\nvar legenda = 'Pix de R$ ' + Number(produto.price).toFixed(2).replace('.', ',') + ' - ' + produto.product_name;\nvar out = { json: { legenda: legenda, qr_code: qrCode, resultado: 'Pix gerado e enviado ao cliente.' } };\nif (qrBase64) {\n  out.binary = { data: { data: qrBase64, mimeType: 'image/png', fileName: 'pix-qrcode.png' } };\n}\nreturn [out];"
      }
    },
