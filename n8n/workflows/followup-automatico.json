    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msgs = ($input.item.json.payload || []).filter(m => m.message_type !== 2);\nconst ultima = msgs[msgs.length - 1];\nconst leadRespondeu = !!(ultima && ultima.message_type === 0);\nconst historico = msgs.slice(-10).map(m => (m.message_type === 0 ? 'Lead' : 'Agente') + ': ' + (m.content || '')).join('\\n');\nconst ctx = $('CALCULAR ESPERA').item.json;\nreturn { json: { ...ctx, lead_respondeu: leadRespondeu, historico } };"
      },
