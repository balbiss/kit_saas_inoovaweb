    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const dados = $input.item.json;\nconst tentativa = parseInt(dados.tentativa) || 1;\nconst horas = parseInt(dados.wait_hours) || 2;\nlet alvoMs = Date.now() + horas * 60 * 60 * 1000;\n\n// Ajusta para horário comercial BRT (UTC-3): Seg-Sex 8h-18h\nfunction ajustar(ms) {\n  const brt = new Date(ms - 3 * 60 * 60 * 1000);\n  const h = brt.getUTCHours();\n  const d = brt.getUTCDay();\n  if (d === 0 || d === 6 || h < 8 || h >= 18) {\n    const next = new Date(brt);\n    if (h >= 18) next.setUTCDate(next.getUTCDate() + 1);\n    next.setUTCHours(9, 0, 0, 0);\n    let nd = next.getUTCDay();\n    while (nd === 0 || nd === 6) { next.setUTCDate(next.getUTCDate() + 1); nd = next.getUTCDay(); }\n    return next.getTime() + 3 * 60 * 60 * 1000;\n  }\n  return ms;\n}\n\nalvoMs = ajustar(alvoMs);\nconst segundos = Math.max(60, Math.round((alvoMs - Date.now()) / 1000));\nreturn { json: { ...dados, segundos_espera: segundos, tentativa_atual: tentativa } };"
      },
