    {
      "parameters": {
        "url": "={{ $('GATILHO').item.json.url_chatwoot }}/api/v1/accounts/{{ $('GATILHO').item.json.id_conta }}/conversations/{{ $('GATILHO').item.json.id_conversa }}/labels",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_access_token",
              "value": "={{ $('GATILHO').item.json.token_chatwoot }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "44f24758-e707-4826-be2f-82c3820b51e1",
      "name": "BUSCAR LABELS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        800,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "var labels = $json.payload || []; if (labels.indexOf('aguardando_confirmacao') === -1) { labels.push('aguardando_confirmacao'); } return [{ json: { labels: labels, body: JSON.stringify({ labels: labels }) } }];"
      },
      "id": "a921bd25-eeff-4623-92e5-4262ab890298",
      "name": "PREPARAR LABELS",
