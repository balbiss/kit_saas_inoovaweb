      "typeVersion": 1.3,
      "position": [
        176,
        320
      ],
      "credentials": {
        "openAiApi": {
          "id": "ftEz13q7mPv07CxS",
          "name": "GUILHERME"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('GATILHO').item.json.url_chatwoot }}/api/v1/accounts/{{ $('GATILHO').item.json.id_conta }}/conversations/{{ $('GATILHO').item.json.id_conversa }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_access_token",
              "value": "={{ $('GATILHO').item.json.token_chatwoot }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.output, message_type: 'outgoing', private: false }) }}",
        "options": {}
      },
      "id": "261efa53-1fee-4ed1-a55a-8e7b73ea3967",
      "name": "ENVIAR MENSAGEM",
