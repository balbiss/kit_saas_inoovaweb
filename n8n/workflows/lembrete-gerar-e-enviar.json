      "typeVersion": 1.1,
      "position": [
        0,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Gere a mensagem de lembrete de confirmacao para o compromisso: \"{{ $json.titulo }}\", agendado para {{ $json.data_hora }}.",
        "options": {
          "systemMessage": "=Voce e assistente de atendimento. Contexto do negocio:\n{{ $json.prompt_nicho }}\n\nGere APENAS a mensagem de WhatsApp de lembrete perguntando se o contato confirma o compromisso ou precisa remarcar. Seja breve (maximo 3 linhas), natural e profissional. Nao adicione prefixo ou explicacoes extras."
        }
      },
      "id": "f87e0a9d-f2bc-49e2-b794-e98ee179e6b4",
      "name": "GERAR LEMBRETE",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "92dd485f-191e-45f1-91d0-d85650898cde",
      "name": "OpenAI Model",
