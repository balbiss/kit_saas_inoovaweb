      "parameters": {
        "jsCode": "var id = $json.query.company_id || ''; var cid = '{{ $env.GOOGLE_CLIENT_ID }}'; var ru = '{{ $env.N8N_URL }}/webhook/calendario-callback'; var url = 'https://accounts.google.com/o/oauth2/auth?client_id=' + encodeURIComponent(cid) + '&redirect_uri=' + encodeURIComponent(ru) + '&response_type=code&scope=' + encodeURIComponent('https://www.googleapis.com/auth/calendar') + '&access_type=offline&prompt=consent&state=' + encodeURIComponent(String(id)); var html = '<!DOCTYPE html><html lang=\"pt-BR\"><head><meta charset=\"UTF-8\"><title>Conectar Calendario</title><style>body{font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;background:#f0f4f8;margin:0}.card{background:white;border-radius:16px;padding:40px;text-align:center;box-shadow:0 4px 24px rgba(0,0,0,.1);max-width:400px;width:90%}.title{font-size:22px;font-weight:700;color:#1a202c;margin-bottom:12px}.desc{color:#64748b;font-size:14px;margin-bottom:28px;line-height:1.6}.btn{display:inline-block;background:#4f46e5;color:white;padding:14px 28px;border-radius:10px;text-decoration:none;font-weight:600;font-size:15px}.info{margin-top:16px;font-size:12px;color:#94a3b8}</style></head><body><div class=\"card\"><div class=\"title\">Conectar Google Calendar</div><div class=\"desc\">Clique abaixo para autorizar o assistente de IA a criar agendamentos automaticamente no seu Google Calendar.</div><a class=\"btn\" href=\"' + url + '\">Conectar com Google</a><div class=\"info\">Conta: ' + id + '</div></div></body></html>'; return [{ json: { html: html } }];"
      }
    },
